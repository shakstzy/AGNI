def chat(messages: list[dict]) -> dict:
    body = json.dumps({"model": MODEL, "messages": messages, "tools": TOOLS}).encode()
    req = urllib.request.Request(
        f"{BASE_URL}/chat/completions", data=body,
        headers={"Authorization": f"Bearer {API_KEY}", "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=120) as resp:
            return json.loads(resp.read())["choices"][0]["message"]
    except urllib.error.HTTPError as e:
        sys.exit(f"API error {e.code}: {e.read().decode()[:500]}")


def dispatch(call: dict) -> str:
    name = call["function"]["name"]
    args = json.loads(call["function"]["arguments"] or "{}")
    if name == "auth":
        label = f"auth {args.get('action')} {args.get('site', '')}".strip()
        print(f"$ {label}", flush=True)
        return auth_tool(args.get("action", ""), args.get("site", ""), args.get("url", ""))
    if name in SYSTEMS:
        argv = [str(a) for a in args.get("argv", [])]
        env = _LOGIN_ENV if args.get("use_login_env") else None
        print(f"$ {' '.join(SYSTEMS[name]['bin'])} {' '.join(argv)}", flush=True)
        return run(name, argv, extra_env=env)
    return f"error: unknown tool {name}"


# ------------------------------------------------------------------- cli ----

def doctor() -> int:
    ok = True
    for name, spec in SYSTEMS.items():
        path = shutil.which(spec["bin"][0])
        print(f"{'ok ' if path else 'MISSING'} {name:9} -> {' '.join(spec['bin'])}: {path or 'not on PATH'}")
        ok &= bool(path)
    if shutil.which("bw"):
        print("bw status:", run("bitwarden", ["status"]))
    if shutil.which("gh"):
        auth = subprocess.run(["gh", "auth", "status"], capture_output=True, text=True)
        print((auth.stdout or auth.stderr).strip())
    if not API_KEY:
        print("MISSING API key: set OPENAI_API_KEY or AGNI_API_KEY")
        ok = False
    return 0 if ok else 1


def routes() -> int:
    for name, spec in SYSTEMS.items():
        guards = f" | guards: {len(spec['guards'])}" if spec["guards"] else ""
        print(f"{name:10} {' '.join(spec['bin']):14} {spec['desc']}{guards}")
    print(f"{'auth':10} {'(pipeline)':14} bw unlock -> creds -> browser fill")
    return 0


def cmd_auth(argv: list[str]) -> int:
    if not argv:
        print("usage: agni auth <bitwarden-item> [--url <login_url>]")
        return 2
    site = argv[0]
    url = argv[argv.index("--url") + 1] if "--url" in argv else ""
    if not shutil.which("bw"):
        sys.exit("error: `bw` not installed")
    print(auth_tool("login", site, url))
    return 0


def main() -> int:
    argv = [a for a in sys.argv[1:] if a != "--dry-run"]
    if not argv:
        print(__doc__)
        return 2
    if argv[0] == "--doctor":
        return doctor()
    if argv[0] == "--routes":
        return routes()
    if argv[0] == "auth":
        return cmd_auth(argv[1:])
    if not API_KEY:
        sys.exit("error: set OPENAI_API_KEY or AGNI_API_KEY")

    messages = [
        {"role": "system", "content": SYSTEM_PROMPT},
        {"role": "user", "content": " ".join(argv)},
    ]
    for _ in range(MAX_TURNS):
        msg = chat(messages)
        messages.append(msg)
        calls = msg.get("tool_calls") or []
        if not calls:
            print(msg.get("content") or "(done)")
            return 0
        for call in calls:
            messages.append({"role": "tool", "tool_call_id": call["id"],
                             "content": dispatch(call)})
    print(f"stopped: hit AGNI_MAX_TURNS={MAX_TURNS}")
    return 1


if __name__ == "__main__":
    sys.exit(main())
