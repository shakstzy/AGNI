{
  "site": "fitbit.com",
  "description": "Fitbit web dashboard for health metrics, daily steps, sleep tracking, and device battery status",
  "base_url": "https://www.fitbit.com",
  "login_required": true,
  "driver": "Browser Use CLI 3.0",
  "pages": {
    "dashboard": {
      "path": "/dashboard",
      "url_patterns": [
        "https://www.fitbit.com/dashboard*"
      ],
      "semantic_anchors": {
        "tiles": ".tile-container",
        "steps_tile": "[data-tile='steps']"
      },
      "key_elements": {
        "steps_counter": {
          "selector": ".steps-value",
          "name": "Daily Steps"
        },
        "sleep_tile": {
          "selector": "[data-tile='sleep']",
          "name": "Sleep Summary"
        }
      },
      "summary": "Main health metrics overview with steps, active minutes, and calories."
    }
  }
}
