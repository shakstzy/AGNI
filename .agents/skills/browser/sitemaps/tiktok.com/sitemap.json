{
  "site": "tiktok.com",
  "description": "TikTok short-form video platform for creator profile research, video metrics, and Studio uploads",
  "base_url": "https://www.tiktok.com",
  "login_required": true,
  "driver": "Browser Use CLI 3.0",
  "pages": {
    "profile": {
      "path": "/@<username>",
      "url_patterns": [
        "https://www.tiktok.com/@*"
      ],
      "semantic_anchors": {
        "user_title": "[data-e2e='user-title']",
        "video_feed": "[data-e2e='user-post-item-list']"
      },
      "key_elements": {
        "follower_count": {
          "selector": "[data-e2e='followers-count']",
          "name": "Follower Count"
        },
        "video_cards": {
          "selector": "[data-e2e='user-post-item']",
          "name": "Video Cards"
        }
      },
      "summary": "Public creator profile with bio, follower stats, and video grid."
    },
    "studio_upload": {
      "path": "/tiktokstudio/upload",
      "url_patterns": [
        "https://www.tiktok.com/tiktokstudio/upload*"
      ],
      "semantic_anchors": {
        "file_input": "input[type='file']",
        "caption_box": "[contenteditable='true']"
      },
      "key_elements": {
        "dropzone": {
          "selector": ".dropzone",
          "name": "Video Dropzone"
        },
        "caption_input": {
          "role": "textbox",
          "name": "Caption input"
        }
      },
      "summary": "TikTok Studio web upload portal for uploading MP4 files and configuring covers."
    },
    "signup": {
      "path": "/signup/phone-or-email/email",
      "url_patterns": [
        "https://www.tiktok.com/signup*",
        "https://www.tiktok.com/signup/phone-or-email/*"
      ],
      "semantic_anchors": {
        "birthday_month": "[aria-label*='Month']",
        "email_input": "input[name='email']",
        "password_input": "input[type='password']",
        "send_code_btn": "button[data-e2e='send-code-button']"
      },
      "key_elements": {
        "birthday_month": {
          "selector": "[aria-label*='Month']",
          "name": "Birthday Month Dropdown"
        },
        "birthday_day": {
          "selector": "[aria-label*='Day']",
          "name": "Birthday Day Dropdown"
        },
        "birthday_year": {
          "selector": "[aria-label*='Year']",
          "name": "Birthday Year Dropdown"
        },
        "email_input": {
          "selector": "input[name='email']",
          "name": "Email Input"
        },
        "password_input": {
          "selector": "input[type='password']",
          "name": "Password Input"
        },
        "code_input": {
          "selector": "input[placeholder*='code']",
          "name": "Verification Code Input"
        },
        "send_code_btn": {
          "selector": "button[data-e2e='send-code-button']",
          "name": "Send Code Button"
        },
        "submit_btn": {
          "selector": "button[type='submit']",
          "name": "Next Submit Button"
        }
      },
      "summary": "TikTok web account registration form with birthday picker, email/password inputs, and 6-digit email OTP verification."
    }
  }
}

